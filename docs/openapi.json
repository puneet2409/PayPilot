  "components": {
    "schemas": {
      "AgentIntent": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "budget": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          },
          "must_have": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Must Have"
          },
          "preferences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Preferences"
          },
          "avoid": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Avoid"
          }
        },
        "type": "object",
        "title": "AgentIntent"
      },
      "AgentTurnRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "search_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Id"
          },
          "user_budget": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "User Budget"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentTurnRequest"
      },
      "AgentTurnResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "reply_text": {
            "type": "string",
            "title": "Reply Text"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentIntent"
              },
              {
                "type": "null"
              }
            ]
          },
          "intent_source": {
            "type": "string",
            "enum": [
              "gemini",
              "rules"
            ],
            "title": "Intent Source",
            "default": "rules"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/RankedCandidate"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "requires_clarification": {
            "type": "boolean",
            "title": "Requires Clarification",
            "default": false
          },
          "clarification_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification Question"
          },
          "suggested_actions": {
            "items": {
              "$ref": "#/components/schemas/SuggestedAction"
            },
            "type": "array",
            "title": "Suggested Actions"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "reply_text"
        ],
        "title": "AgentTurnResponse"
      },
      "AuditTimelineEvent": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "prev_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Hash"
          },
          "entry_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Hash"
          }
        },
        "type": "object",
        "required": [
          "id",
          "event_type",
          "details",
          "created_at"
        ],
        "title": "AuditTimelineEvent"
      },
      "AuditTimelineResponse": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/AuditTimelineEvent"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "AuditTimelineResponse"
      },
      "CheckoutCaptureRequest": {
        "properties": {
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 38,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "simulate_price_drift": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simulate Price Drift",
            "default": false
          }
        },
        "type": "object",
        "title": "CheckoutCaptureRequest"
      },
      "CheckoutCaptureResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentDetails"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "status",
          "payment"
        ],
        "title": "CheckoutCaptureResponse"
      },
      "CheckoutCreateRequest": {
        "properties": {
          "quote_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Quote Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Session Id"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 38,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "quote_id",
          "session_id"
        ],
        "title": "CheckoutCreateRequest"
      },
      "CheckoutCreateResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "paypal_order_id": {
            "type": "string",
            "title": "Paypal Order Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "paypal_mode": {
            "type": "string",
            "enum": [
              "sandbox",
              "simulated"
            ],
            "title": "Paypal Mode"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "paypal_order_id",
