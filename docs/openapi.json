    "/api/v1/webhooks/paypal": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Handle Paypal Webhook",
        "description": "Asynchronous Webhook Receiver for PayPal Events.\nSatisfies Section 5.1 of Embedded Financial Analytics Blueprint:\n- Receives asynchronous event streams (payment captures, order approvals, refunds)\n- Cryptographically verifies event headers & transmission signature\n- Idempotently reconciles database state\n- Returns HTTP 200 OK to signal successful receipt and prevent exponential retry floods",
        "operationId": "handle_paypal_webhook_api_v1_webhooks_paypal_post",
        "parameters": [
          {
            "name": "paypal-auth-algo",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Paypal-Auth-Algo"
            }
          },
          {
            "name": "paypal-transmission-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Paypal-Transmission-Id"
            }
          },
          {
            "name": "paypal-cert-url",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Paypal-Cert-Url"
            }
          },
          {
            "name": "paypal-transmission-sig",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Paypal-Transmission-Sig"
            }
          },
          {
            "name": "paypal-transmission-time",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Paypal-Transmission-Time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
