# Application Environment
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./paypilot.db
FRONTEND_ORIGIN=http://localhost:5173
# Use a random value of at least 32 characters in production.
SESSION_SIGNING_SECRET=

# PayPal Sandbox Configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 Product Discovery API
# (Claim 20,000 free search credits using promo code: PAYPAL-HACKATHON-2026 at docs.trychannel3.com)
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# AI Orchestration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
